{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
  "@/*": ["./src/*"],
  "@shared/*": [
    "../shared/*",
    "./shared/*"
  ]
},
  },
  "include": [
  "src/**/*.ts",
  "../shared/**/*.ts",
  "shared/**/*.ts"
]
}