# =====================================
# Application
# =====================================
NODE_ENV=development
PORT=3000

# =====================================
# Database - PostgreSQL
# =====================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=enter_password_here
POSTGRES_DB=enter_database_name_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# =====================================
# JWT - RS256
# =====================================
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_EXPIRES_IN=15m

# =====================================
# Session
# =====================================
SESSION_SECRET=enter_session_secret_here

# =====================================
# 42 OAuth
# =====================================
FORTYTWO_CLIENT_ID=generated_client_id
FORTYTWO_CLIENT_SECRET=generated_client_secret
FORTYTWO_REDIRECT_URI=http://localhost:3000/api/v1/auth/42/callback

# =====================================
# Frontend
# =====================================
FRONTEND_URL=http://localhost:5173

# =====================================
# Debugging
# =====================================
DEBUG=express:*,router,router:* node index.js
NODE_DEBUG=http