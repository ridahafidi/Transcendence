# =====================================
# Application
# =====================================
NODE_ENV=development
PORT=3000

# =====================================
# Database - PostgreSQL
# =====================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_NAME=transcendence
POSTGRES_DB=transcendence

# =====================================
# JWT - RS256
# =====================================
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_EXPIRES_IN=15m

# =====================================
# Session
# =====================================
SESSION_SECRET=openssl rand -hex 32 in your terminal to generate a new secret

# =====================================
# 42 OAuth
# =====================================
FORTYTWO_CLIENT_ID=u-s4t2ud-a37af588e2ac7334015411f7f50d3dd2d4ddc9a19752009f96a4630e32a7da6a
FORTYTWO_CLIENT_SECRET=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
FORTYTWO_REDIRECT_URI=http://localhost:3000/api/v1/auth/42/callback

# =====================================
# Frontend
# =====================================
FRONTEND_URL=http://localhost:5173

# =====================================
# Debugging
# =====================================
DEBUG=express:*,router,router:* node index.js
NODE_DEBUG=http